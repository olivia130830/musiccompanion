{
  "name": "musiccompanion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS= concurrently -k -n qwen,next \"NODE_OPTIONS= node --env-file=.env.local server/qwen/realtime-proxy.mjs\" \"NODE_OPTIONS= next dev --hostname 127.0.0.1\"",
    "dev:next": "NODE_OPTIONS= next dev --hostname 127.0.0.1",
    "dev:qwen": "NODE_OPTIONS= node --env-file=.env.local server/qwen/realtime-proxy.mjs",
    "dev:direct": "NODE_OPTIONS= next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@audio/decode-webm": "^1.2.1",
    "@google/genai": "^2.9.0",
    "@vercel/blob": "^2.4.1",
    "@vercel/functions": "^3.7.5",
    "essentia.js": "^0.1.3",
    "next": "16.2.9",
    "openai": "^6.44.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.0.0"
  }
}
