{
  "name": "musiccompanion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS= concurrently -k -n auth,qwen,next \"npm run dev:auth\" \"NODE_OPTIONS= node --env-file-if-exists=.env.local server/qwen/realtime-proxy.mjs\" \"NODE_OPTIONS= next dev --hostname 127.0.0.1\"",
    "dev:auth": "TSX_TSCONFIG_PATH=auth-server/tsconfig.json NODE_OPTIONS= node --watch --env-file-if-exists=.env.local --import tsx auth-server/src/main.ts",
    "dev:next": "NODE_OPTIONS= next dev --hostname 127.0.0.1",
    "dev:qwen": "NODE_OPTIONS= node --env-file-if-exists=.env.local server/qwen/realtime-proxy.mjs",
    "dev:direct": "NODE_OPTIONS= next dev",
    "build": "npm run build:auth && next build",
    "build:auth": "tsc -p auth-server/tsconfig.json",
    "start": "next start",
    "start:auth": "node --env-file-if-exists=.env.local dist-auth/main.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p auth-server/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@audio/decode-webm": "^1.2.1",
    "@google/genai": "^2.9.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.1",
    "@vercel/functions": "^3.7.5",
    "cookie-parser": "^1.4.7",
    "essentia.js": "^0.1.3",
    "next": "16.2.9",
    "nodemailer": "^10.0.10",
    "openai": "^6.44.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.0.0"
  }
}
