# NestJS account service
AUTH_BACKEND_URL=http://127.0.0.1:4000
AUTH_PORT=4000
AUTH_HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
OTP_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Gmail SMTP requires a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
SMTP_FROM=MusicCompanion <your-account@gmail.com>

# Existing MusicCompanion services
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
